---
interface Props {
  contactSection: any
  siteSettings: any
}

const {contactSection, siteSettings} = Astro.props
const contact = contactSection || {}
const wa = siteSettings?.whatsappNumber || '6281217219682'
const ig = siteSettings?.instagramHandle || 'kopi.pagipagi'
const email = siteSettings?.email || 'kopi.bangunpagi@gmail.com'

const impactStats = contact.impactStats || [
  {value: '500+', label: 'Hampers'},
  {value: '0%', label: 'Plastik'},
  {value: '100%', label: 'Eco'},
]
---
<section id="contact" class="section contact-section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-left animate-on-scroll">
        <span class="badge" data-i18n="contact.badge">{contact.badge?.id || 'Hubungi Kami'}</span>
        <h2 class="section-title" data-i18n="contact.title">{contact.title?.id || 'Siap Membuat Hampers Impian Anda?'}</h2>
        <p class="section-desc" data-i18n="contact.description">{contact.description?.id || 'Hubungi kami melalui WhatsApp untuk konsultasi dan pemesanan.'}</p>
        <div class="contact-ctas">
          <a href={`https://wa.me/${wa}?text=Halo%20Kopi%20Pagi%20Pagi%2C%20saya%20tertarik%20dengan%20hampers%20Anda`} target="_blank" class="btn btn-whatsapp btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            <span data-i18n="contact.ctaWa">Chat via WhatsApp</span>
          </a>
          <a href={`https://instagram.com/${ig}`} target="_blank" class="btn btn-outline-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
            <span data-i18n="contact.ctaIg">Follow Instagram</span>
          </a>
        </div>
        <div class="contact-cards">
          <div class="contact-card">
            <div class="contact-card-icon icon-whatsapp">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            </div>
            <div>
              <small data-i18n="contact.infoWa">WhatsApp</small>
              <strong>+{wa.replace(/(\d{2})(\d{4})(\d{4})(\d{3})/, '$1 $2-$3-$4')}</strong>
            </div>
          </div>
          <div class="contact-card">
            <div class="contact-card-icon icon-instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
            </div>
            <div>
              <small data-i18n="contact.infoIg">Instagram</small>
              <strong>@{ig}</strong>
            </div>
          </div>
          <div class="contact-card">
            <div class="contact-card-icon icon-email">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <small data-i18n="contact.infoEmail">Email</small>
              <strong>{email}</strong>
            </div>
          </div>
          <div class="contact-card">
            <div class="contact-card-icon icon-location">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <small data-i18n="contact.infoLocation">Lokasi</small>
              <strong data-i18n="contact.locationValue">Indonesia</strong>
            </div>
          </div>
        </div>
      </div>
      <div class="contact-right animate-on-scroll">
        <div class="impact-card">
          <div class="impact-icon">🌿</div>
          <h3 data-i18n="contact.impactTitle">{contact.impactTitle?.id || 'Setiap Pesanan Membawa Dampak'}</h3>
          <p data-i18n="contact.impactDesc">{contact.impactDescription?.id || 'Bergabunglah dengan kami dalam mendukung kehidupan berkelanjutan'}</p>
          <div class="impact-stats">
            {impactStats.map((stat: any) => (
              <div class="impact-stat">
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </div>
            ))}
          </div>
          <div class="impact-hours">
            <div class="impact-hours-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span data-i18n="contact.hoursTitle">Jam Operasional</span>
            </div>
            <p data-i18n="contact.hoursWeekday">{contact.operatingHours?.weekday?.id || 'Senin - Jumat: 09:00 - 17:00'}</p>
            <p data-i18n="contact.hoursWeekend">{contact.operatingHours?.weekend?.id || 'Sabtu: 09:00 - 14:00'}</p>
          </div>
        </div>
        <div class="impact-card-border"></div>
      </div>
    </div>
  </div>
</section>
