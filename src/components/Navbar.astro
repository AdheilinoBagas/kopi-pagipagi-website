---
import {urlFor} from '../lib/image'

interface Props {
  siteSettings: any
}

const {siteSettings} = Astro.props
const logoUrl = siteSettings?.logo ? urlFor(siteSettings.logo).width(200).url() : '/images/logo.png'
---
<nav class="navbar" id="navbar">
  <div class="navbar-inner">
    <a href="#home" class="navbar-logo">
      <img src={logoUrl} alt="Kopi Pagi Pagi" class="navbar-logo-img">
    </a>
    <div class="navbar-links" id="navLinks">
      <a href="#home" data-i18n="nav.home">Beranda</a>
      <a href="#about" data-i18n="nav.about">Tentang</a>
      <a href="#products" data-i18n="nav.products">Produk</a>
      <a href="#gallery" data-i18n="nav.gallery">Galeri</a>
      <a href="#testimonials" data-i18n="nav.testimonials">Testimoni</a>
      <a href="#contact" data-i18n="nav.contact">Kontak</a>
    </div>
    <div class="navbar-actions">
      <button class="btn-lang" id="themeToggle" title="Toggle dark mode">☀️</button>
      <button class="btn-lang" id="langToggle" title="Switch language">EN</button>
      <a href={`https://wa.me/${siteSettings?.whatsappNumber || '6281217219682'}?text=Halo%20Kopi%20Pagi%20Pagi%2C%20saya%20tertarik%20dengan%20hampers%20Anda`} target="_blank" class="btn btn-primary btn-sm navbar-cta" data-i18n="nav.orderNow">Pesan Sekarang</a>
      <button class="btn-hamburger" id="hamburger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="navbar-mobile" id="mobileMenu">
    <a href="#home" data-i18n="nav.home">Beranda</a>
    <a href="#about" data-i18n="nav.about">Tentang</a>
    <a href="#products" data-i18n="nav.products">Produk</a>
    <a href="#gallery" data-i18n="nav.gallery">Galeri</a>
    <a href="#testimonials" data-i18n="nav.testimonials">Testimoni</a>
    <a href="#contact" data-i18n="nav.contact">Kontak</a>
    <a href={`https://wa.me/${siteSettings?.whatsappNumber || '6281217219682'}?text=Halo%20Kopi%20Pagi%20Pagi%2C%20saya%20tertarik%20dengan%20hampers%20Anda`} target="_blank" class="btn btn-primary btn-block" data-i18n="nav.orderNow">Pesan Sekarang</a>
  </div>
</nav>
